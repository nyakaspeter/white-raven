#!/bin/sh
#
# White Raven Server Init Script
# Created by SilentMurdock
# Websites: https://github.com/silentmurdock
#
. /dtv/SGO.env

# ALWAYS MAKE SURE THIS FILE IS SAVED WITH UNIX LINE ENDINGS (LF)!

# TMDB API key used for movie and TV metadata
TMDBKEY='a4d9ad8d2d072c50dc998cc0d1a508fa'

# OpenSubtitles.com API key and optional credentials
OPENSUBTITLESKEY=''
OPENSUBTITLESUSER=''
OPENSUBTITLESPASSWORD=''

# Jackett API address and key
JACKETTADDRESS=''
JACKETTKEY=''

# nCore credentials
NCOREUSER=''
NCOREPASSWORD=''

# iNSANE credentials
INSANEUSER=''
INSANEPASSWORD=''

# Torrent storage memory size in MB; 128 MB works for H-series TVs
MEMORYSIZE='128'

# Transfer limits in Kbps; the widget can override them as arguments 2 and 3
DOWNSPEED="${2:-0}"
UPSPEED="${3:-0}"

# Maximum connections per torrent
MAXCONNECTIONS='50'

# Set to '-nodht' to disable DHT
NODHT=''

# Set to '-noipv6' to disable IPv6
NOIPV6='-noipv6'

# Set to '-noutp' to disable UDP
NOUTP='-noutp'

# Set to '-forcegc' to force garbage collection when memory storage evicts data
FORCEGC='-forcegc'

SERVERDIR='/mtd_rwcommon/widgets/user/WhiteRaven/server'
SERVERPATH='/mtd_rwcommon/widgets/user/WhiteRaven/server/wrserver'

check_processor() {
	CPUTYPE=$(uname -m | awk '{print substr($0,1,3)}')
	if [ "$CPUTYPE" != "arm" ]; then
		echo "No ARM processor found. Init halted."
		exit 1
	fi
}

set_swappiness() {
	SWAPPINESS=$(sysctl -n vm.swappiness)
	if [ "$SWAPPINESS" -gt 30 ]; then
		sysctl -w vm.swappiness=30
	fi
}

start_wrserver() {
	SERVERSTATUS=$(ps -ef | grep wrserver | grep -v grep)
	if [ -z "$SERVERSTATUS" ]; then
		cd "$SERVERDIR" || exit 1
		chmod 755 "$SERVERPATH"
		sync && echo 3 > /proc/sys/vm/drop_caches
		set_swappiness
		./wrserver \
			-background \
			-storagetype memory \
			-memorysize "$MEMORYSIZE" \
			-downrate "$DOWNSPEED" \
			-uprate "$UPSPEED" \
			-maxconn "$MAXCONNECTIONS" \
			$NODHT \
			$NOIPV6 \
			$NOUTP \
			$FORCEGC \
			-tmdbkey "$TMDBKEY" \
			-osuser "$OPENSUBTITLESUSER" \
			-ospassword "$OPENSUBTITLESPASSWORD" \
			-osapikey "$OPENSUBTITLESKEY" \
			-jackettaddress "$JACKETTADDRESS" \
			-jackettkey "$JACKETTKEY" \
			-ncoreuser "$NCOREUSER" \
			-ncorepassword "$NCOREPASSWORD" \
			-insaneuser "$INSANEUSER" \
			-insanepassword "$INSANEPASSWORD"
	fi
}

case "$1" in
	start) check_processor; start_wrserver ;;
	stop)
		PIDS=$(ps -ef | grep wrserver | grep -v grep | awk '{print $2}')
		if [ -n "$PIDS" ]; then kill -2 $PIDS; fi
		;;
	status)
		if ps -ef | grep wrserver | grep -v grep >/dev/null; then
			echo "White Raven Server is running."
		else
			echo "White Raven Server is stopped."
		fi
		;;
	*) echo "Usage: $0 {start|stop|status} downspeed upspeed" >&2 ;;
esac
