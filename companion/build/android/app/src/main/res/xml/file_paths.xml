<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Camera captures are written here and shared with the camera app via the
         FileProvider. -->
    <cache-path name="captures" path="captures/" />

    <!-- Update APKs are downloaded into <filesDir>/updates and handed to the
         system package installer via FileProvider. Plain file:// URIs into the
         app's private storage are inaccessible to other apps on Android 7+. -->
    <files-path name="updates" path="updates/" />
</paths>
