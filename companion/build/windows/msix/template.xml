<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="white-raven-companion"
        Arguments=""
        InstallLocation="C:\Program Files\White Raven Companion\White Raven Companion">
    </Installer>
    <PackageInformation
        PackageName="White Raven Companion"
        PackageDisplayName="White Raven Companion"
        PublisherName="CN=White Raven"
        PublisherDisplayName="White Raven"
        Version="0.1.0.0"
        PackageDescription="Run and configure White Raven Server">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.whiteraven.server"
                Description="Run and configure White Raven Server"
                DisplayName="White Raven Companion"
                ExecutableName="white-raven-companion"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>White Raven Companion</DisplayName>
            <PublisherDisplayName>White Raven</PublisherDisplayName>
            <Description>Run and configure White Raven Server</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="white-raven-companion.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
